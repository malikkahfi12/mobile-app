{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "$EXPO_PUBLIC_API_URL",
        "EXPO_PUBLIC_API_KEY": "$EXPO_PUBLIC_API_KEY",
        "EXPO_PUBLIC_MAPTILER_KEY": "$EXPO_PUBLIC_MAPTILER_KEY",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "$EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "$EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_PROD_API_URL": "$EXPO_PUBLIC_PROD_API_URL",
        "EXPO_PUBLIC_API_KEY": "$EXPO_PUBLIC_API_KEY",
        "EXPO_PUBLIC_MAPTILER_KEY": "$EXPO_PUBLIC_MAPTILER_KEY",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "$EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "$EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID"
      }
    }
  }
}
